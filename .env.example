# Machine-local settings for the SpanTui tooling (dev.bat, start.bat,
# package.bat, tools\*.ps1). Copy to .env (git-ignored) and uncomment what
# your machine needs; nothing here is required when Qt is installed in
# <drive>:\Qt (the installer's default C:\Qt) or its qmake/cmake are on PATH,
# with MinGW, CMake and Ninja from its Tools\ or on PATH. Run dev.bat doctor
# to see what the tooling finds.
#
# A variable already set in the environment wins over this file. The
# application itself never reads it.

# Qt installation root (the folder holding 6.x.y\ and Tools\). Discovery picks
# the newest <version>\mingw_64 kit and the MinGW, CMake and Ninja under Tools\.
#SPANTUI_QT_SDK_ROOT=C:\Qt

# Override single pieces when they live elsewhere.
#SPANTUI_QT_ROOT=C:\Qt\6.12.0\mingw_64
#SPANTUI_MINGW_BIN=C:\Qt\Tools\mingw1310_64\bin
#SPANTUI_CMAKE=C:\Qt\Tools\CMake_64\bin\cmake.exe
#SPANTUI_NINJA_DIR=C:\Qt\Tools\Ninja

# Linker the compiler driver runs (-fuse-ld=<value>); unset keeps GNU ld.
# lld links much faster and needs ld.lld on PATH (e.g. from LLVM). CI uses it.
#SPANTUI_LINKER=lld
# Folder of ld.<linker>.exe when it is neither on PATH nor, for lld, in
# %ProgramFiles%\LLVM\bin.
#SPANTUI_LINKER_DIR=D:\tools\llvm\bin
# OFF builds without debug info (-g0): smaller objects, faster links. CI uses it.
#SPANTUI_DEBUG_INFO=OFF

# sccache (used when on PATH): the tooling runs one server per repository,
# shared by the main checkout and its worktrees so they reuse each other's
# objects. Its cache defaults to <SPANTUI_BUILD_ROOT>\sccache, or
# target\sccache of the main checkout.
#SPANTUI_SCCACHE_DIR=D:\cache\spantui-sccache
# external leaves sccache to the environment (CI starts its own server).
#SPANTUI_SCCACHE=external

# Where build trees and packages go. Unset, everything lands in the
# git-ignored target\ of the checkout: target\build (dev build, tests, diag
# output, stress TUI) and target\release\<version> (portable package and Setup).
# A relative value is taken from the main checkout. Each checkout builds in
# its own subfolder: <root>\main, or <root>\wt-<id> for a git worktree
# (dev.bat worktree add). A worktree without its own .env reads this one.
#SPANTUI_BUILD_ROOT=D:\cache\workspaces\span-tui\qt
# New worktrees go to <main checkout folder>.worktrees beside the checkout.
#SPANTUI_WORKTREE_ROOT=D:\work\spantui-worktrees
# Packages go to <root>\span-tui\<version>\windows-x64 instead; an
# incomplete slot of the same version is discarded and rebuilt.
#SPANTUI_ARTIFACT_ROOT=D:\artifacts

# Packaging (dev.bat package) only: Inno Setup compiler when it is neither on
# PATH nor in its default folder, and the thumbprint of the CN=Span
# code-signing certificate when the store holds more than one.
#SPANTUI_ISCC=C:\Tools\Inno Setup 6\ISCC.exe
#SPANTUI_MSIX_CERT_THUMBPRINT=
